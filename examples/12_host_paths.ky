# From a namespace Path back to a real OS path. Everything else in kyu
# addresses files by namespace path (/work/a.txt), but a legacy binary
# reached with %cmd only understands real paths -- handing it a Path that
# exists only in the namespace is an error pointing at checkout.
# host_path(path) is the way across when the file really is on disk: it
# returns the OS path behind a namespace Path, as a String. (path(str) is
# the reverse crossing, String to Path.)
#
# Self-contained, like 08/09: bind dir("/tmp") for scratch space and
# remove the one file it creates.
bind dir("/tmp"), /scratch
write(/scratch/9sh-example-host.txt, "hello host_path")

# The obvious case: a dir(...) bind resolves to its directory plus the
# path within it.
plain := host_path(/scratch/9sh-example-host.txt)

# A path-bind is followed back to its source, so an alias reports the
# same real file -- and the bind point itself answers with its directory.
bind /scratch, /alias
via_alias := host_path(/alias/9sh-example-host.txt)
alias_root := host_path(/alias)

# That String is what a %cmd argument needs. (An argument has to be a
# plain value, not a call, so name the result first.) `test -s` succeeds
# only if a real, non-empty file exists at that path -- the binary opens
# it directly, no checkout involved.
real := host_path(/scratch/9sh-example-host.txt)
%test "-s" real
test_exit := exit_code()

# Only a path with a real OS path behind it has an answer. The rest --
# a dial() remote, /jobs, /env, a synthetic directory, a union bind -- is
# an ordinary ErrorVal (falsy, so `!` is true), never a guess.
no_host_path := !host_path(/jobs)

rm(/scratch/9sh-example-host.txt)

format(
    "plain {} same_via_alias {} alias_root {}; test -s exited {}; /jobs has no host path: {}",
    plain,
    plain == via_alias,
    alias_root,
    test_exit,
    no_host_path,
)
