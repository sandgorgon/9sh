# %cmd calls an ordinary external binary. A %cmd ... & job is a live
# record backed by real namespace files under /jobs -- j.status,
# j.ctl = "stop", j | wait all read/write through, not a snapshot.

# A quick backgrounded job.
j := %sleep "0.2" &
before := j.status.state

# Block until it reaches a terminal state, then read it again -- same
# Record, updated in place.
j | wait
after := j.status.state

# && / || chain by real exit status, like a shell -- but only a *bare*
# %cmd operand gets this treatment (storing the result first, like j
# above, opts out on purpose).
%true && %echo "chained on success"

# exit_code() is bash's $? -- it tracked that last foreground %cmd,
# the %echo the chain above ran.
chain_result := exit_code()

# `&` isn't only for %cmd -- any kyu expression can be backgrounded as
# an in-process job instead of a subprocess one (status.kind says
# which). A bare `{ ... }` block is auto-invoked with zero arguments;
# its result comes back the same way a %cmd's captured stdout does --
# as bytes on the job's own stdout field (try `inproc_job.stdout` at
# the interactive prompt to see 42; format()'s `{}` below shows Bytes
# as a "<N bytes>" summary instead, the same as it would for any %cmd's
# captured output). A backgrounded while-true or unbounded self-
# recursion is killable exactly like a subprocess job too
# (`inproc_job.ctl = "kill"`), just cooperative rather than a real
# signal -- there's no OS process to send one to.
inproc_job := { 6 * 7 } &
inproc_job | wait
inproc_kind := inproc_job.status.kind

# The command name itself can be computed too: %(expr) evaluates expr
# to a String at call time, then behaves exactly like a literal %name
# from there -- the %-sigil counterpart to @(expr) for a job's mount
# point (see 07_remote_and_local_namespaces.ky). Useful when the
# command to run isn't known until runtime, e.g. picked from a variable
# or built from a prefix.
cmd_name := "echo"
%(cmd_name) "hi from a computed command name"
computed_name_exit := exit_code()

# ps() is the structured, no-checkout-needed view of every job at
# /jobs -- "every command is a job" is load-bearing, not incidental:
# the background sleep, the in-process job above, and both foreground
# commands in the chain above all show up here, which is what makes
# session history meaningful in real use.
job_count := ps() | count

format(
    "background job went from '{}' to '{}'; chained command's exit code was {}; the { 6 * 7 } & job's kind is '{}'; %(cmd_name) exited {}; {} job(s) total now recorded at /jobs",
    before,
    after,
    chain_result,
    inproc_kind,
    computed_name_exit,
    job_count,
)
